#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

ln -sf "$PWD/.bashrc" "$HOME/.bashrc"
ln -sf "$PWD/.bash_logout" "$HOME/.bash_logout"
ln -sf "$PWD/.dircolors" "$HOME/.dircolors"
ln -sf "$PWD/.wezterm.lua/" "$HOME/.weztermlua"
ln -sf "$PWD/.inputrc" "$HOME/.inputrc"
ln -sf "$PWD/.profile" "$HOME/.profile"
ln -sf "$PWD/.profile" "$HOME/.bash_profile"
ln -sf "$PWD/Scripts" "$HOME/Scripts"

for i in vim lynx gh git tmux iam; do
	cd $i && ./setup
	cd -
done
